# Copy to ~/.config/note_search/watch.env and adjust for your setup.
# Used by the note-search-watch.service systemd user unit.

NOTE_SEARCH_DIR=/home/youruser/notes
NOTE_SEARCH_DATABASE=/home/youruser/notes/note.sqlite

# Optional: custom attribute-mapping config path (defaults to ~/.config/note_search/config)
# NOTE_SEARCH_CONFIG=/home/youruser/.config/note_search/config
